# PostgreSQL
POSTGRES_DB=northwind
POSTGRES_USER=northwind
POSTGRES_PASSWORD=northwind_dev

# Full DSN used by the backend
DATABASE_URL=postgresql+asyncpg://northwind:northwind_dev@localhost:5433/northwind

# LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# File storage: "local" for dev, "r2" for production
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# Cloudflare R2 (only needed when STORAGE_BACKEND=r2)
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Retrieval / validation thresholds
RETRIEVAL_TOP_K=5
POLICY_QA_MIN_SIMILARITY=0.45
CITATION_FUZZY_THRESHOLD=90
CITATION_SEMANTIC_THRESHOLD=0.90
CONFIDENCE_PENALTY_PER_FAILED_CITATION=0.20
